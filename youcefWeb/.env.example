# Variables d'environnement du serveur (à définir avant `npm start`, ne pas commiter)
MAIL_TO=youcef@exemple.fr
MAIL_FROM=no-reply@exemple.fr
SMTP_HOST=smtp.exemple.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google Agenda de Youcef, en lecture seule (console Google Cloud > identifiants OAuth "Application Web").
# URI de redirection autorisée : <url du site>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_REDIRECT_URI=http://localhost:4200/api/google/callback
