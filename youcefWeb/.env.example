# Copier ce fichier en ".env" (dans ce dossier, à côté de package.json) puis remplacer la valeur.
# Jeton personnel Calendly : https://calendly.com/integrations/api_webhooks
CALENDLY_TOKEN=votre_jeton_ici

# Demandes de devis : envoyées par e-mail à Youcef (serveur SMTP de votre fournisseur de mail)
SMTP_HOST=smtp.exemple.fr
SMTP_PORT=587
SMTP_USER=utilisateur
SMTP_PASS=mot_de_passe
DEVIS_DESTINATAIRE=youcef@exemple.fr
# Optionnel : adresse d'expédition (par défaut SMTP_USER)
#DEVIS_EXPEDITEUR=

# Comptes et documents (voir COMPTES.md)
# Secret unique, 32 caractères minimum : sert à chiffrer les données et à signer les sessions et les liens de réinitialisation.
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ATTENTION : si vous le perdez ou le changez, les données déjà enregistrées deviennent illisibles.
APP_SECRET=
# Adresse e-mail de Youcef : son compte se crée au premier « Mot de passe oublié » avec cette adresse.
PRO_EMAIL=youcef@exemple.fr
# Adresse publique du site (sans / final), utilisée dans les liens des e-mails de réinitialisation.
SITE_URL=https://votre-site.vercel.app
# Hébergement Vercel : défini automatiquement quand vous créez un « Blob store » dans l'onglet Storage du projet.
# Sans lui, les données sont écrites dans le dossier ./donnees (développement local, ou serveur personnel : DATA_DIR pour le changer).
#BLOB_READ_WRITE_TOKEN=
