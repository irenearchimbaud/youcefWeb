# Copier ce fichier en ".env" (dans ce dossier, à côté de package.json) puis remplacer la valeur.
# Jeton personnel Calendly : https://calendly.com/integrations/api_webhooks
CALENDLY_TOKEN=votre_jeton_ici

# Demandes de devis : envoyées par e-mail à Youcef (serveur SMTP de votre fournisseur de mail)
SMTP_HOST=smtp.exemple.fr
SMTP_PORT=587
SMTP_USER=utilisateur
SMTP_PASS=mot_de_passe
DEVIS_DESTINATAIRE=youcef@exemple.fr
# Optionnel : adresse d'expédition (par défaut SMTP_USER)
#DEVIS_EXPEDITEUR=
